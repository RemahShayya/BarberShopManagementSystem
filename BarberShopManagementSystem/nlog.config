<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="c:\temp\WebApiFsp-Internal-Logs.txt">

	<!-- enable asp.net core layout renderers -->
	<extensions>
		<add assembly="NLog.Web.AspNetCore"/>
	</extensions>

	<!-- the targets to write to -->
	<targets async="true">

		<!-- File Target for all log messages -->
		<target xsi:type="File"
				name="allfile"
				fileName="C:\Users\Remah\Desktop\Projects\logs\BarberShopManagementSystemLogs-all.log"
				archiveEvery="Week"
				archiveNumbering="Rolling"
				maxArchiveFiles="1"
				layout="${longdate}|${event-properties:item=EventId:whenEmpty=0}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}" />

		<!-- JSON Web Logs -->
		<target xsi:type="File"
				name="ownFile-web"
				fileName="C:\Users\Remah\Desktop\Projects\logs\BarberShopManagementSystemLogs-web.json"
				archiveEvery="Week"
				archiveNumbering="Rolling"
				maxArchiveFiles="1">

			<layout xsi:type="JsonLayout" includeEventProperties="true">
				<attribute name="time" layout="${longdate}" />
				<attribute name="event" layout="${event-properties:item=EventId:whenEmpty=0}"/>
				<attribute name="level" layout="${level:upperCase=true}"/>
				<attribute name="logger" layout="${logger}"/>
				<attribute name="message" layout="${message}" />
				<attribute name="exception" layout="${exception:format=tostring}"/>
				<attribute name="url" layout="${aspnet-request-url}" />
				<attribute name="action" layout="${aspnet-mvc-action}" />
			</layout>

		</target>

		<!-- Console Target -->
		<target xsi:type="Console"
				name="lifetimeConsole"
				layout="${MicrosoftConsoleLayout}" />

	</targets>

	<!-- rules to map from logger name to target -->
	<rules>

		<!-- Hide Microsoft & EF Info/Debug spam -->
		<logger name="Microsoft.*" minlevel="Warn" writeTo="allfile, ownFile-web" final="true" />
		<logger name="System.*" minlevel="Warn" writeTo="allfile, ownFile-web" final="true" />
		<logger name="Microsoft.EntityFrameworkCore.*" minlevel="Warn" writeTo="allfile, ownFile-web" final="true" />

		<!-- Your application logs -->
		<logger name="*" minlevel="Info" writeTo="allfile, ownFile-web" />

		<!-- Hosting lifetime to console -->
		<logger name="Microsoft.Hosting.Lifetime" minlevel="Info" writeTo="lifetimeConsole" final="true" />

	</rules>
	
</nlog>